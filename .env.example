# Copiá este archivo a .env.local (o .env.<cliente>) y completá la configuración web de la instancia de Firebase del cliente.
# Se obtiene en Firebase > Configuración del proyecto > Tus apps > app web. Estos valores no son secretos.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Solo para la instancia de demostración:
# VITE_DEMO_MODE=true
