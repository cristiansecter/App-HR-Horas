{
  "name": "horus",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "build:demo": "tsc --noEmit && vite build --mode demo",
    "deploy:demo": "npm run build:demo && npx firebase-tools deploy --only hosting,firestore:rules,firestore:indexes --project demo",
    "test:rules": "npx --yes firebase-tools@15 emulators:exec --only firestore --project horus-rules-test \"vitest run --config vitest.rules.config.ts\"",
    "provision": "tsx scripts/provision-instance.ts",
    "create-user": "tsx scripts/create-user.ts",
    "set-role": "tsx scripts/set-role.ts",
    "create-configurator": "tsx scripts/create-configurator.ts"
  },
  "dependencies": {
    "exceljs": "^4.4.0",
    "firebase": "^12.19.0",
    "lucide-react": "^0.544.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.9.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.4",
    "firebase-admin": "^14.5.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.15",
    "typescript": "~5.8.2",
    "vite": "^7.1.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "@grpc/grpc-js": "^1.14.7",
    "@firebase/app-compat": "0.5.23",
    "@firebase/app": "0.16.7"
  }
}
