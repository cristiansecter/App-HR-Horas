rules_version = '2';

// Reglas de seguridad de Horus. Los permisos los hacen cumplir estas reglas; la pantalla solo esconde lo que
// el usuario no puede usar. El rol sale del custom claim `role` del token ('admin' | 'supervisor' | 'employee'),
// que solo asigna el Configurador con un script de Admin SDK. Todo lo que no está acá está denegado.
service cloud.firestore {
  match /databases/{database}/documents {

    // ------------------------------------------------------------ quién es quién
    function signedIn() {
      return request.auth != null;
    }
    function role() {
      return request.auth.token.get('role', '');
    }
    // La baja de una persona (users/{uid}.active == false) le corta el acceso de inmediato, aunque su token siga
    // vigente: se comprueba en cada pedido. Si no existe su perfil, se deniega.
    function isActiveAccount() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('active', true) != false;
    }
    function hasRole() {
      return signedIn() && role() in ['admin', 'supervisor', 'employee'] && isActiveAccount();
    }
    // El Configurador es el proveedor del sistema, no un rol de la pyme. Entra SOLO con su cuenta de Google: se exige el
    // correo exacto, verificado, y que ESTA sesión haya iniciado con Google (una sesión por contraseña con el mismo correo
    // no alcanza). No tiene rol, así que no puede leer ni escribir datos de la empresa: solo administra los módulos y el
    // modelo de pago. Si el proveedor cambia, se cambia el correo acá y en src/config/configurator.ts.
    function isConfigurator() {
      return signedIn()
        && request.auth.token.get('email', '') == 'cristiansecter@gmail.com'
        && request.auth.token.get('email_verified', false) == true
        && request.auth.token.firebase.get('sign_in_provider', '') == 'google.com';
    }
    // Módulo activo en esta instancia (settings/features). Si el documento no existe, todo está apagado.
    function moduleOn(name) {
      return exists(/databases/$(database)/documents/settings/features)
        && get(/databases/$(database)/documents/settings/features).data.get('modules', {}).get(name, false) == true;
    }
    function validFeatures(d) {
      return d.keys().hasOnly(['modules', 'payModel', 'updatedAt', 'updatedBy'])
        && d.modules is map
        && d.modules.keys().hasOnly(['compensation', 'performance', 'payroll'])
        && d.modules.get('compensation', false) is bool
        && d.modules.get('performance', false) is bool
        && d.modules.get('payroll', false) is bool
        && d.payModel in ['salary', 'hourly']
        // Un módulo no puede estar activo sin la base de la que depende.
        && (d.modules.get('performance', false) == false || d.modules.get('compensation', false) == true)
        && (d.modules.get('payroll', false) == false || d.modules.get('compensation', false) == true);
    }
    function isAdmin() {
      return hasRole() && role() == 'admin';
    }
    function me() {
      return request.auth.uid;
    }
    function profileOf(uid) {
      return get(/databases/$(database)/documents/users/$(uid)).data;
    }
    // El usuario `uid` es del equipo del supervisor que hace el pedido.
    function supervises(uid) {
      return hasRole() && role() == 'supervisor' && exists(/databases/$(database)/documents/users/$(uid))
        && profileOf(uid).get('supervisorId', '') == me();
    }
    function isApproverOf(uid) {
      return isAdmin() || supervises(uid);
    }
    function onlyChanges(allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    // ------------------------------------------------------------ ventana de edición
    // Un empleado carga y corrige registros propios de los últimos N días (editWindowDays de settings, 7 por defecto).
    function editWindowDays() {
      return exists(/databases/$(database)/documents/settings/main)
        ? get(/databases/$(database)/documents/settings/main).data.get('editWindowDays', 7)
        : 7;
    }
    function inWindow(ms) {
      return ms is int
        && ms >= request.time.toMillis() - editWindowDays() * 24 * 60 * 60 * 1000
        && ms <= request.time.toMillis() + 24 * 60 * 60 * 1000;
    }

    // ------------------------------------------------------------ registros de horas: quién puede qué
    function ownerEdits() {
      return hasRole() && resource.data.userId == me()
        && resource.data.status in ['draft', 'observed']
        && request.resource.data.status in ['draft', 'submitted']
        && inWindow(resource.data.dateMs) && inWindow(request.resource.data.dateMs)
        && onlyChanges(['projectId', 'date', 'dateMs', 'startTime', 'endTime', 'isOnCall', 'ticketRef', 'notes',
                        'status', 'updatedAt']);
    }
    function approverDecides() {
      return hasRole() && isApproverOf(resource.data.userId) && (resource.data.userId != me() || isAdmin())
        && resource.data.status == 'submitted'
        && request.resource.data.status in ['approved', 'observed']
        && request.resource.data.reviewedBy == me()
        && onlyChanges(['status', 'reviewerNote', 'reviewedBy', 'reviewedAt', 'hours', 'breakdown'])
        && (request.resource.data.status == 'observed'
              ? (request.resource.data.reviewerNote is string && request.resource.data.reviewerNote.size() > 0)
              : (request.resource.data.hours is number && request.resource.data.breakdown is map));
    }

    // ------------------------------------------------------------ perfil del equipo
    // Lo leen todos los usuarios con rol (hace falta para el directorio y el calendario). Los datos sensibles
    // están en employee_private. Nadie puede cambiar el rol desde acá: viene del token.
    match /users/{uid} {
      allow read: if hasRole();
      allow update: if isAdmin()
        && request.resource.data.get('role', '') == resource.data.get('role', '')
        && onlyChanges(['fullName', 'email', 'employeeNumber', 'department', 'position', 'hireDate',
                        'supervisorId', 'workSchedule', 'active']);
      allow create, delete: if false;
    }

    // Remuneración de cada persona (módulo "Sueldos en el legajo"): solo el administrador y solo si el módulo está
    // activo en la instancia. Nadie más lo lee, ni siquiera la propia persona ni su supervisor.
    match /employee_pay/{uid} {
      allow read, delete: if isAdmin() && moduleOn('compensation');
      allow create, update: if isAdmin() && moduleOn('compensation')
        && request.resource.data.keys().hasOnly(['userId', 'rates', 'convenio', 'obraSocial', 'hijos', 'updatedAt', 'updatedBy'])
        && request.resource.data.userId == uid
        && request.resource.data.rates is list && request.resource.data.rates.size() <= 400
        && request.resource.data.get('convenio', true) is bool
        && request.resource.data.get('obraSocial', '') is string && request.resource.data.get('obraSocial', '').size() <= 80
        && request.resource.data.get('hijos', 0) is int && request.resource.data.get('hijos', 0) >= 0 && request.resource.data.get('hijos', 0) <= 30;
    }

    // Tarifa de cobro por hora de cada proyecto (módulo "Rendimiento"): solo el administrador. Va aparte de `projects`
    // porque ese documento lo lee todo el equipo y la tarifa no.
    match /project_rates/{code} {
      allow read, delete: if isAdmin() && moduleOn('performance');
      allow create, update: if isAdmin() && moduleOn('performance')
        && request.resource.data.keys().hasOnly(['hourlyRate', 'billable', 'updatedAt', 'updatedBy'])
        && request.resource.data.hourlyRate is number && request.resource.data.hourlyRate >= 0 && request.resource.data.hourlyRate <= 1000000000
        && request.resource.data.billable is bool;
    }

    // Liquidación de sueldos (módulo "Liquidación"): solo el administrador y solo con el módulo activo.
    // Un período cerrado no admite crear, cambiar ni borrar recibos.
    function periodClosed(period) {
      return exists(/databases/$(database)/documents/payroll_periods/$(period))
        && get(/databases/$(database)/documents/payroll_periods/$(period)).data.get('closed', false) == true;
    }
    match /payslips/{id} {
      allow read: if isAdmin() && moduleOn('payroll');
      allow create, update: if isAdmin() && moduleOn('payroll')
        && request.resource.data.keys().hasOnly(['userId', 'period', 'manual', 'result', 'rate', 'payModel', 'createdAt', 'createdBy', 'updatedAt'])
        && request.resource.data.userId is string && request.resource.data.period is string
        && request.resource.data.period.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && id == request.resource.data.userId + '_' + request.resource.data.period
        && request.resource.data.result is map && request.resource.data.manual is map
        && !periodClosed(request.resource.data.period);
      allow delete: if isAdmin() && moduleOn('payroll') && !periodClosed(resource.data.period);
    }
    match /payroll_periods/{period} {
      allow read: if isAdmin() && moduleOn('payroll');
      allow create, update: if isAdmin() && moduleOn('payroll')
        && period.matches('^[0-9]{4}-(0[1-9]|1[0-2])$')
        && request.resource.data.keys().hasOnly(['closed', 'closedAt', 'closedBy', 'reopenedAt', 'reopenedBy'])
        && request.resource.data.closed is bool;
    }

    // Datos sensibles (CUIL, DNI, teléfono, modalidad): solo el administrador.
    match /employee_private/{uid} {
      allow read, write: if isAdmin();
    }

    // ------------------------------------------------------------ configuración de la empresa
    // `settings/features` (módulos activables y modelo de pago) lo escribe SOLO el Configurador, nunca el administrador
    // de la pyme. Como las reglas se suman (alcanza con que una permita), el comodín de abajo lo excluye a propósito.
    match /settings/features {
      allow read: if hasRole() || isConfigurator();
      allow write: if isConfigurator() && validFeatures(request.resource.data);
    }
    // Parámetros de costos y de liquidación: solo el administrador y solo con su módulo activo.
    match /settings/costing {
      allow read, delete: if isAdmin() && moduleOn('performance');
      allow create, update: if isAdmin() && moduleOn('performance')
        && request.resource.data.keys().hasOnly(['employerContributionsPct', 'monthlyHours', 'updatedAt', 'updatedBy'])
        && request.resource.data.employerContributionsPct is number && request.resource.data.employerContributionsPct >= 0 && request.resource.data.employerContributionsPct <= 200
        && request.resource.data.monthlyHours is number && request.resource.data.monthlyHours >= 1 && request.resource.data.monthlyHours <= 400;
    }
    match /settings/payroll {
      allow read, delete: if isAdmin() && moduleOn('payroll');
      allow create, update: if isAdmin() && moduleOn('payroll')
        && request.resource.data.keys().hasOnly(['params', 'visibility', 'updatedAt', 'updatedBy'])
        && request.resource.data.params is map && request.resource.data.visibility is map;
    }
    // El resto de `settings` (menos los documentos con regla propia) lo lee todo el equipo y lo escribe el administrador.
    match /settings/{doc} {
      allow read: if (hasRole() || isConfigurator()) && !(doc in ['features', 'costing', 'payroll']);
      allow write: if isAdmin() && !(doc in ['features', 'costing', 'payroll']);
    }
    match /holidays/{date} {
      allow read: if hasRole();
      allow write: if isAdmin();
    }
    match /projects/{id} {
      allow read: if hasRole();
      allow write: if isAdmin();
    }

    // ------------------------------------------------------------ registros de horas
    // El empleado carga fecha, desde y hasta. Las horas y el desglose finales (hours, breakdown) los escribe
    // únicamente quien aprueba, y quedan congelados. Un registro aprobado no se edita.
    match /time_entries/{id} {
      allow read: if hasRole() && (resource.data.userId == me() || isApproverOf(resource.data.userId));

      allow create: if hasRole()
        && request.resource.data.userId == me()
        && request.resource.data.keys().hasOnly(['userId', 'projectId', 'date', 'dateMs', 'startTime', 'endTime',
                                                 'isOnCall', 'ticketRef', 'notes', 'status', 'createdAt', 'updatedAt'])
        && request.resource.data.status in ['draft', 'submitted']
        && request.resource.data.startTime is string && request.resource.data.endTime is string
        && inWindow(request.resource.data.dateMs);

      // El dueño corrige mientras el registro está en borrador u observado y dentro de la ventana.
      // Quien aprueba (supervisor del dueño o administrador) decide sobre registros enviados.
      allow update: if ownerEdits() || approverDecides();

      allow delete: if hasRole() && resource.data.userId == me() && resource.data.status == 'draft'
        && inWindow(resource.data.dateMs);
    }

    // ------------------------------------------------------------ licencias
    // El empleado solicita (pendiente). El supervisor del dueño o el admin deciden. La ausencia injustificada
    // no se solicita: la registra quien supervisa, ya aprobada.
    match /leave_requests/{id} {
      allow read: if hasRole() && (resource.data.userId == me() || isApproverOf(resource.data.userId));

      allow create: if hasRole() && request.resource.data.createdBy == me()
        && request.resource.data.keys().hasOnly(['userId', 'type', 'startDate', 'endDate', 'daysCount', 'reason',
                                                 'attachmentPath', 'status', 'createdBy', 'approvedBy', 'decidedAt',
                                                 'createdAt'])
        && (
          (request.resource.data.userId == me()
            && request.resource.data.type in ['vacation', 'sick', 'study', 'personal']
            && request.resource.data.status == 'pending')
          ||
          (isApproverOf(request.resource.data.userId) && request.resource.data.userId != me()
            && request.resource.data.type == 'unjustified'
            && request.resource.data.status == 'approved'
            && request.resource.data.approvedBy == me())
        );

      allow update: if hasRole() && isApproverOf(resource.data.userId) && (resource.data.userId != me() || isAdmin())
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && request.resource.data.approvedBy == me()
        && onlyChanges(['status', 'approvedBy', 'decidedAt', 'reviewerNote']);

      allow delete: if hasRole() && resource.data.userId == me() && resource.data.status == 'pending';
    }

    // Calendario del equipo: solo "ausente", sin el tipo de licencia (es un dato de salud).
    match /team_absences/{id} {
      allow read: if hasRole();
      allow create, update: if hasRole() && isApproverOf(request.resource.data.userId)
        && request.resource.data.keys().hasOnly(['userId', 'startDate', 'endDate', 'leaveId']);
      allow delete: if hasRole() && isApproverOf(resource.data.userId);
    }
  }
}
